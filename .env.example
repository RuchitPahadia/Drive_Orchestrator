# Photo Orchestrator — environment variable template.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# --- Database (PostgreSQL + pgvector; e.g. Supabase/Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Optional: path to (or inline PEM of) your database's CA certificate. When set,
# TLS server-certificate verification is enabled. When unset, the connection is
# encrypted but NOT verified (a warning is logged in production).
# DATABASE_CA_CERT="/path/to/supabase-ca.pem"

# --- NextAuth (v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL="http://localhost:3000"   # set in non-Vercel deployments if auto-detection is wrong

# --- Google OAuth (login + Drive account linking) ---
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/accounts/callback"

# --- Token encryption (AES-256-GCM for stored OAuth tokens) ---
# Any sufficiently long secret; it is hashed to a 32-byte key.
TOKEN_ENCRYPTION_KEY="generate-a-long-random-secret"

# --- Background jobs (optional; without Redis, indexing runs inline) ---
# REDIS_URL="redis://localhost:6379"

# --- Logging (optional: debug | info | warn | error; default warn in production) ---
# LOG_LEVEL="info"
